### Border radius

```yaml
radius:
  none: 0
  sm: 4px
  md: 8px
  lg: 12px
  full: 999px
```

### Elevation / shadow

```yaml
shadow:
  none: 0
  sm: "0 1px 2px rgba(0,0,0,.04)"
  md: "0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.06)"
  lg: "0 4px 12px rgba(0,0,0,.08), 0 20px 48px rgba(0,0,0,.12)"
```

### Motion tokens

```yaml
duration:
  fast: 150ms
  base: 250ms
  slow: 400ms

easing:
  out: "cubic-bezier(0.16, 1, 0.3, 1)"     # ease-out-quart
