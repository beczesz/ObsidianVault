 OPENAI_MODEL = "whisper-1"
 
+# Local backend (faster-whisper / CTranslate2). large-v3-turbo: 809M params,
+# ~8x faster than large-v3, runs offline on CPU (incl. Apple Silicon). No key.
+LOCAL_MODEL = "large-v3-turbo"
+
+
+def local_available() -> bool:
+    """True if faster-whisper is importable (local backend possible)."""
+    try:
+        import faster_whisper  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+def resolve_backend(preferred: str | None = None) -> tuple[str, str | None] | tuple[None, None]:
+    """Pick a transcription backend.
+
+    - preferred == "local"            -> ("local", None)
+    - preferred in {"groq","openai"}  -> that API if its key exists, else (None, None)
+    - preferred is None               -> prefer an API key (Groq>OpenAI); if none,
+                                         auto-fall back to local when faster-whisper
+                                         is installed.
+    """
+    if preferred == "local":
+        return ("local", None)
+    backend, api_key = load_api_key(preferred)
+    if backend and api_key:
+        return (backend, api_key)
+    if preferred is None and local_available():
+        return ("local", None)
+    return (None, None)
+
+
+def transcribe_local(
+    video_path: str,
+    audio_out: Path,
+    model_name: str = LOCAL_MODEL,
+    start: float | None = None,
+    end: float | None = None,
+) -> list[dict]:
+    """Transcribe offline via faster-whisper. Language auto-detected.
+
+    First run downloads the model (~1.5 GB) to ~/.cache/huggingface; later runs
+    load from cache. When start/end are given, only that clip is transcribed and
+    segment times are shifted back to absolute (real video timeline). Returns
+    segments in the same {start,end,text} shape as the API path.
+    """
+    from faster_whisper import WhisperModel
+
+    print("[watch] extracting audio for local Whisper…", file=sys.stderr)
+    audio_path = extract_audio(video_path, audio_out, start=start, end=end)
+    offset = start or 0.0
+
+    print(
+        f"[watch] loading faster-whisper '{model_name}' on CPU "
+        f"(first run downloads the model)…",
+        file=sys.stderr,
+    )
+    model = WhisperModel(model_name, device="cpu", compute_type="int8")
+
+    seg_iter, info = model.transcribe(str(audio_path.resolve()), beam_size=5)
+    segments: list[dict] = []
+    for s in seg_iter:
+        text = (s.text or "").strip()
+        if text:
+            segments.append({
+                "start": round(float(s.start) + offset, 2),
+                "end": round(float(s.end) + offset, 2),
+                "text": text,
+            })
+
+    print(
+        f"[watch] transcribed {len(segments)} segments via local "
+        f"(lang={info.language}, p={info.language_probability:.2f})",
+        file=sys.stderr,
+    )
+    return segments
+
 
